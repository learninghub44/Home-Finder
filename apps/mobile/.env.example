# Copy this file to .env and fill in real values. Never commit .env.
# EXPO_PUBLIC_* vars are bundled into the client — do not put server-only secrets here.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary (unsigned upload preset — safe for client use)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=home_finder_unsigned

# Google Maps (used natively via app.json — also needed here for any JS-side geocoding calls)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
